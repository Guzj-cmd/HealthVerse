{
  "random_seed": 42,
  "split": {
    "train_fraction": 0.70,
    "validation_fraction": 0.15,
    "test_fraction": 0.15,
    "group_field": "subject_id"
  },
  "thresholds": {
    "accuracy": 0.85,
    "macro_f1": 0.80,
    "minimum_class_recall": 0.70,
    "minimum_test_subjects": 3,
    "minimum_test_samples_per_class": 30,
    "minimum_pose_coverage": 0.90
  },
  "models": {
    "logistic_regression": {"C": 1.0, "max_iter": 3000},
    "random_forest": {"n_estimators": 400, "max_depth": 18, "min_samples_leaf": 2},
    "hist_gradient_boosting": {"max_iter": 300, "learning_rate": 0.06, "max_leaf_nodes": 31},
    "edusense_mlp": {"hidden_layer_sizes": [128, 64], "alpha": 0.0005, "max_iter": 600}
  }
}
