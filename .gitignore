# Build output
target/
*.war

# Local credentials and machine-specific configuration
*.local.properties
.env
.env.*
!.env.example
.claude/

# Python caches and environments
__pycache__/
*.py[cod]
.venv/
venv/

# Raw or converted datasets are reproducible from the cited public source
machine-learning/data/
machine-learning/**/data/
*.sqlite3

# External research datasets are downloaded locally and are never redistributed
ccfa-workfiles/**/cache/

# BEHAVE-derived weights stay local until the dataset owner confirms redistribution
machine-learning/runs/behave-relation-v1/model.joblib

# Charades source features and derived weights are non-redistributable
machine-learning/runs/charades-relation-v1/model.joblib
machine-learning/runs/behave-relation-v2/model.joblib

# Local camera/video captures and preference records
captures/
preferences/*.jsonl
*.mp4
*.webm

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

